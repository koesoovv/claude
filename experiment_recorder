            "Reject_Reason": str(_get(core, "last_reject_reason", "unknown")),
            "Control_Profile": str(_get(core, "last_control_profile", "default")),
        }

    core_lock = getattr(core, "lock", None)
    if core_lock is not None:
        try:
            with core_lock:
                return read_values()
        except Exception:
            pass
    return read_values()


def _timeseries_worker(core: Any, trial_id: str) -> None:
    idx = 0
    while True:
        with _state_lock:
            state = _active
            if state is None or state.get("trial_id") != trial_id:
                return
            stop_event = state["stop_event"]
            start_mono = state["record_start_monotonic"]
            interval = state["sample_interval_sec"]

        if stop_event.is_set():
            return

        row = _snapshot_timeseries_row(core, trial_id, idx, time.monotonic() - start_mono)
        with _state_lock:
            if _active is None or _active.get("trial_id") != trial_id:
                return
            _active["timeseries"].append(row)

        idx += 1
        stop_event.wait(interval)


def _write_timeseries(trial_id: str, rows: list[Dict[str, Any]]) -> Path:
    _ensure_dirs()
    path = TIMESERIES_DIR / f"{trial_id}.csv"
    with path.open("w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=TIMESERIES_HEADER, extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow({key: row.get(key, "") for key in TIMESERIES_HEADER})
    return path


