#!/usr/bin/env python3
"""
experiment_recorder.py
======================
스마트 정수기 실험 자동 기록 모듈.

기능
- Trial_ID 자동 생성
- 0.2초 주기 core 상태 시계열 저장
- 급수 종료 시 core 최종 상태 snapshot
- 실측 채움률 입력 후 trial_summary.csv 최종 저장
- 컵 이름(Cup_Name)별 cup_info.csv 등록/재사용
"""
from __future__ import annotations

