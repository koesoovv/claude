]

_state_lock = threading.RLock()
_active: Optional[Dict[str, Any]] = None
_pending: Optional[Dict[str, Any]] = None


def _ensure_dirs() -> None:
    DATA_ROOT.mkdir(parents=True, exist_ok=True)
    TIMESERIES_DIR.mkdir(parents=True, exist_ok=True)


def _safe_float(value: Any, default: Optional[float] = 0.0) -> Optional[float]:
    try:
        if value is None:
            return default
        return float(value)
    except (TypeError, ValueError):
        return default


def _get(core: Any, name: str, default: Any = 0.0) -> Any:
    return getattr(core, name, default)


def _ai_train_samples() -> int:
    """보정 모델이 지금까지 학습한 표본 수(기록/추적용)."""
    if fill_corrector is None:
        return 0
    try:
        return int(fill_corrector.get_model().n_samples)
    except Exception:                                              # noqa: BLE001
        return 0


def _bool_text(value: Any) -> str:
    return "TRUE" if bool(value) else "FALSE"


def _append_csv(path: Path, header: list[str], row: Dict[str, Any]) -> None:
    _ensure_dirs()
    write_header = not path.exists() or path.stat().st_size == 0
    with path.open("a", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=header, extrasaction="ignore")
        if write_header:
            writer.writeheader()
        writer.writerow({key: row.get(key, "") for key in header})


def _next_trial_id() -> str:
    _ensure_dirs()
    next_no = 1
    if COUNTER_FILE.exists():
        try:
            text = COUNTER_FILE.read_text(encoding="utf-8").strip()
            next_no = int(text) + 1 if text else 1
        except Exception:
            next_no = 1

    if SUMMARY_FILE.exists():
        try:
            with SUMMARY_FILE.open("r", newline="", encoding="utf-8-sig") as f:
                max_no = 0
                for row in csv.DictReader(f):
                    trial_id = str(row.get("Trial_ID", ""))
                    if trial_id.startswith("Trial_"):
                        try:
                            max_no = max(max_no, int(trial_id.split("_", 1)[1]))
                        except Exception:
                            pass
                next_no = max(next_no, max_no + 1)
        except Exception:
            pass

    COUNTER_FILE.write_text(str(next_no), encoding="utf-8")
    return f"Trial_{next_no:04d}"


def register_cup(
    cup_name: str,
    height_cm: Optional[float] = None,
    top_diameter_cm: Optional[float] = None,
    bottom_diameter_cm: Optional[float] = None,
    note: str = "",
) -> None:
    """컵 이름(Cup_Name)을 기준으로 cup_info.csv에 등록/갱신."""
    _ensure_dirs()
    cup_name = (cup_name or "unknown").strip()

    rows = []
    if CUP_INFO_FILE.exists():
        try:
            with CUP_INFO_FILE.open("r", newline="", encoding="utf-8-sig") as f:
                rows = list(csv.DictReader(f))
        except Exception:
            rows = []

    new_row = {
        "Cup_Name": cup_name,
        "Cup_Height_cm": "" if height_cm is None else height_cm,
        "Cup_Top_Diameter_cm": "" if top_diameter_cm is None else top_diameter_cm,
        "Cup_Bottom_Diameter_cm": "" if bottom_diameter_cm is None else bottom_diameter_cm,
        "Note": note or "",
    }

    found = False
    for idx, row in enumerate(rows):
        if str(row.get("Cup_Name", "")).strip() == cup_name:
            merged = dict(row)
            for key, value in new_row.items():
                if key == "Cup_Name" or value not in ("", None):
                    merged[key] = value
            rows[idx] = merged
            found = True
            break

    if not found:
        rows.append(new_row)

    with CUP_INFO_FILE.open("w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=CUP_INFO_HEADER, extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow({key: row.get(key, "") for key in CUP_INFO_HEADER})

def _read_cup_info(cup_name: str) -> Dict[str, Any]:
    if not CUP_INFO_FILE.exists():
        return {}
    try:
        with CUP_INFO_FILE.open("r", newline="", encoding="utf-8-sig") as f:
            for row in csv.DictReader(f):
                if str(row.get("Cup_Name", "")).strip() == str(cup_name).strip():
                    return row
    except Exception:
        pass
    return {}

def start_trial(
    core: Any,
    cup_name: str,
    *,
    cup_height_cm: Optional[float] = None,
    cup_top_diameter_cm: Optional[float] = None,
    cup_bottom_diameter_cm: Optional[float] = None,
    code_version: str = DEFAULT_CODE_VERSION,
    sample_interval_sec: float = DEFAULT_SAMPLE_INTERVAL_SEC,
) -> str:
    """새 실험 기록 시작. core.start_filling_local() 직후 호출 권장."""
    global _active, _pending
    with _state_lock:
        if _active is not None:
            raise RuntimeError(f"이미 기록 중: {_active['trial_id']}")
        if _pending is not None:
            raise RuntimeError(
                f"실측값 저장 대기 중: {_pending['trial_id']}. finalize_trial() 후 다음 실험을 시작하세요."
            )

        trial_id = _next_trial_id()
        register_cup(
            cup_name,
            height_cm=cup_height_cm,
            top_diameter_cm=cup_top_diameter_cm,
            bottom_diameter_cm=cup_bottom_diameter_cm,
        )

        _active = {
            "trial_id": trial_id,
            "cup_name": (cup_name or "unknown").strip(),
            "started_at": datetime.now().isoformat(timespec="seconds"),
            "record_start_monotonic": time.monotonic(),
            "sample_interval_sec": max(0.05, float(sample_interval_sec)),
            "code_version": str(code_version),
            "timeseries": [],
            "stop_event": threading.Event(),
        }

        worker = threading.Thread(
            target=_timeseries_worker,
            args=(core, trial_id),
            daemon=True,
            name=f"timeseries-{trial_id}",
        )
        _active["worker"] = worker
        worker.start()
        print(f"\n[REC] {trial_id} 시작 | Cup={cup_name} | Target={_get(core, 'TARGET_FILL_PCT', 0)}%")
        return trial_id


def _core_elapsed(core: Any) -> float:
    try:
        return max(
            0.0,
            time.time()
            - float(_get(core, "filling_start_time", time.time()))
            - float(_get(core, "NOISE_CALIBRATION_TIME", 0.0)),
        )
    except Exception:
        return 0.0


