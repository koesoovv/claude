            "Theory_Locked": _bool_text(_get(core, "theory_locked", False)),
            "Dynamic_Q": _safe_float(_get(core, "dynamic_Q", 0.0)),
            "Noise_Floor_Level": _safe_float(_get(core, "noise_floor_level", 0.0)),
            "Spike_Blocked_Count": int(_safe_float(_get(core, "spike_blocked_count", 0), 0) or 0),
            "Max_Freq_Seen_Hz": _safe_float(_get(core, "max_freq_seen", 0.0)),
            "Tracking_Mode": _bool_text(_get(core, "tracking_mode", False)),
